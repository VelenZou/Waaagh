<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.waaagh</id>
    <name>WAAAGH</name>
    <vendor email="velenzou@users.noreply.github.com" url="https://github.com/velenzou/waaagh">velenzou</vendor>

    <description>
        <![CDATA[
            <b>English</b>
            <br><br>
            <b>WAAAGH</b> is a collection of IntelliJ IDEA plugins. Popular tools may later be spun out
            as standalone plugins.
            <br><br>
            <b>Current tool: Feign &lt;-&gt; Controller navigation</b>
            <ul>
              <li><b>Go to Implementation</b> (Ctrl+Alt+B) from Feign methods to matching Controllers</li>
              <li><b>Go to Declaration</b> (Ctrl+B / Ctrl+Click) between Feign and Controller</li>
              <li><b>Call Hierarchy</b> integration — Feign appears as callers of Controllers, and Controllers appear as callees of Feign</li>
            </ul>
            Also supports <code>server.servlet.context-path</code> / <code>spring.mvc.servlet.path</code>
            and package-based path prefixes (<code>PathMatchConfigurer#addPathPrefix</code>),
            bilateral PSI cache, and full-URL clipboard copy.
            <br><br>
            <br><br>
            <b>中文</b>
            <br><br>
            <b>WAAAGH!!!</b> —— 一个 IntelliJ IDEA 插件集合。集合里受欢迎的子工具，
            未来可能会被拆分成独立插件。
            <br><br>
            <b>当前工具：Feign ↔ Controller 跳转</b>
            <ul>
              <li><b>Go to Implementation</b>（Ctrl+Alt+B）：从 Feign 方法跳转到匹配的 Controller</li>
              <li><b>Go to Declaration</b>（Ctrl+B / Ctrl+单击）：在 Feign 与 Controller 之间互相跳转</li>
              <li><b>Call Hierarchy</b>：Feign 显示为 Controller 的调用方，Controller 显示为 Feign 的被调用方</li>
            </ul>
            支持解析 <code>server.servlet.context-path</code> / <code>spring.mvc.servlet.path</code>，
            按子包注册的路径前缀（<code>PathMatchConfigurer#addPathPrefix</code>），
            双边 PSI 缓存，以及一键复制完整 URL。
            <br><br>
            <a href="https://github.com/velenzou/waaagh">GitHub</a>
        ]]>
    </description>

    <change-notes>
        <![CDATA[
            <b>1.0.1</b>
            <ul>
              <li>Feign inheritance: endpoints declared on a base API interface (extended by an empty @FeignClient sub-interface) are now navigable and appear in Call Hierarchy.</li>
              <li>Call Hierarchy: Controller methods now list matching Feign clients as callers.</li>
            </ul>
            <b>1.0.0</b>
            <ul>
              <li>Initial release: Feign ↔ Controller Go to Implementation / Go to Declaration and Call Hierarchy.</li>
            </ul>
        ]]>
    </change-notes>

    <version>1.0.0</version>
    <idea-version since-build="203.0"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Gutter icon navigation -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.waaagh.provider.F2CLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.waaagh.provider.C2FLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.waaagh.provider.CopyControllerUrlLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.waaagh.provider.CopyFeignUrlLineMarkerProvider"/>

        <!-- Go to Implementation (Ctrl+Alt+B) -->
        <definitionsScopedSearch implementation="com.waaagh.navigation.FeignDefinitionsSearcher"/>

        <!-- Go to Declaration / Ctrl+Click -->
        <gotoDeclarationHandler implementation="com.waaagh.navigation.FeignGotoDeclarationHandler"/>

        <!-- Call Hierarchy: Feign methods show Controllers as callees; Controllers show Feign clients as callers. Delegates non-mapping to Java. -->
        <callHierarchyProvider language="JAVA" order="first"
                               implementationClass="com.waaagh.hierarchy.WaaaghCallHierarchyProvider"/>

        <notificationGroup id="Waaagh"
                           displayType="BALLOON"
                           key="notification.group.name"/>

        <iconProvider id="com.waaagh.provider.tabIcon.FeignClassIconProvider"
                      implementation="com.waaagh.provider.tabIcon.FeignClassIconProvider"/>
        <iconProvider id="com.waaagh.provider.tabIcon.RestControllerIconProvider"
                      implementation="com.waaagh.provider.tabIcon.RestControllerIconProvider"/>

        <applicationConfigurable implementation="com.waaagh.user.UserPluginConfigurableUI"/>

    </extensions>

    <!-- Project lifecycle: ProjectManagerListener is a message bus topic, not an extension point. -->
    <applicationListeners>
        <listener class="com.waaagh.listener.app.CacheCleanListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
        <!-- 保存 / 外部编辑器修改被 IDEA 同步后清理全量扫描缓存，下次查询自动重扫（无需重开项目） -->
        <listener class="com.waaagh.listener.app.VfsCacheRefreshListener"
                  topic="com.intellij.openapi.vfs.VirtualFileManager"/>
    </applicationListeners>

</idea-plugin>
