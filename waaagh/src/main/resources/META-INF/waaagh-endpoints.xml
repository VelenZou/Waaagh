<idea-plugin>
    <!--
      WAAAGH 的 Endpoints 工具窗口集成（Ultimate 专属）。

      仅在装有 Endpoints 插件（com.intellij.microservices.ui）的 IDE 中加载，
      因此 Community 版与老版本 IDE 不会看到、也不会尝试加载这些扩展。
    -->
    <extensions defaultExtensionNs="com.intellij.microservices">
        <!-- Feign 客户端端点（HTTP-Client）：@FeignClient path + 方法映射 -->
        <endpointsProvider order="last"
                           implementation="com.waaagh.endpoints.WaaaghFeignEndpointsProvider"/>
        <!-- MVC Controller 端点（HTTP-Server）：context-path + servlet.path + 前缀 + 映射 -->
        <endpointsProvider order="last"
                           implementation="com.waaagh.endpoints.WaaaghMvcEndpointsProvider"/>
    </extensions>
</idea-plugin>
